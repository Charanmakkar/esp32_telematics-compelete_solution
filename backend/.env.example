ENVIRONMENT=development
DB_HOST=192.168.9.59
DB_PORT=3306
DB_NAME=navsphere
DB_USER=navsphere
DB_PASSWORD=
# Explicit opt-in standalone demonstration only; MySQL is the normal default:
# DATABASE_URL=sqlite:///./navsphere-demo.db
MQTT_HOST=192.168.9.59
MQTT_PORT=1883
MQTT_USERNAME=navsphere_backend
MQTT_PASSWORD=
MQTT_ENABLED=true
MQTT_TLS=false
# MQTT_CA_FILE=C:/path/to/ca.crt
DEVICE_IDS=ESP32_001
MQTT_TOPIC_PREFIX=navsphere
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
# Only used to create a missing initial account. Production requires >=12 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
AUTO_MIGRATE=false
# 1..30 seconds; must not exceed firmware CONFIG_NAV_COMMAND_MAX_TTL_MS / 1000.
COMMAND_TIMEOUT_SECONDS=10
SESSION_TTL_SECONDS=28800
INGEST_QUEUE_SIZE=2048
DATABASE_RETRY_SECONDS=10
DEVICE_STALE_SECONDS=3
