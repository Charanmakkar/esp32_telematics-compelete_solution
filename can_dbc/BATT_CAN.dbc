CM_ "HV_CORE v1.3";
CM_ BO_ 2498862693 "DEBUG Message";
CM_ BO_ 2499740773 "Message on BATT (internal multi pack CAN bus) for backup speaker handshake";
CM_ SG_ 2499740773 HVESP01_speakerClaimFlag "Active speaker will set this bit to 1.
Rest of the packs will set this value to 0.
Backup speaker will set this bit to 1 in case of _speakerClaimFlag_1
";
CM_ SG_ 2499740773 HVESP01_expectedSpeakerID "Default all the packs will set this value to 1.
Pack 2 shall set this signal to 2 in case of trying to become speaker.  ";
CM_ BO_ 2499764325 "EU battery passport; application-scheduled every 1000 ms; CAN ID 0x14FF6065; 500 kbit/s.";
CM_ SG_ 2499764325 HVESP01_DPP_Pack_ID "One-based battery pack identifier (1-8); used by the speaker as the receive-array index.";
CM_ SG_ 2499764325 HVESP01_DPP_Data_ID "1=Battery life status;  2=Battery capacity;  3-7=SOC history;  8-10=power capability;  11=charge/discharge count; 12-17=temperature history;  18=deep-discharge event count;  19=overcharge event count;  20=post-event status.";
CM_ SG_ 2499764325 HVESP01_DPP_Data_Value "Raw value selected by Data_ID. See PASSPORT_DATA_ID_MAPPING for encoding and units. IDs 8-10 use 0.1 W/bit; other IDs use factor 1. All offsets are 0. Upper bits for values shorter than 32 bits are unspecified.";
CM_ SG_ 2499764325 HVESP01_DPP_Message_Counter "Incremented per pack frame; rolls over 255 to 0.";
CM_ SG_ 2499764325 HVESP01_DPP_Data_Status "0=Valid; 1=Invalid / not available.";
CM_ BO_ 2499764581 "EU battery passport; application-scheduled every 1000 ms; CAN ID 0x14FF6165; 500 kbit/s.";
CM_ SG_ 2499764581 HVESP01_DPP_Pack_ID "One-based battery pack identifier (1 to 8).";
CM_ SG_ 2499764581 HVESP01_Segment_ID "Cumulative byte count for a 64-byte DPP ID: 6, 12, ..., 60, 64. Ten chunks carry six bytes and the final chunk carries four bytes; restart from the first chunk for the next transfer.";
CM_ SG_ 2499764581 HVESP01_DPP_Info "Up to six DPP ID bytes in payload bytes 2-7. Identifier length is exactly 64 bytes. The final chunk contains four ID bytes followed by two zero padding bytes. No terminator is transmitted.";
CM_ BO_ 2499750501 "AFE V+ total voltage, modules 01-04; 0xFFFF encodes unavailable.";
